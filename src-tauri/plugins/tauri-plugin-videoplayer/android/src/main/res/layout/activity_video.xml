<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ExoPlayer surface (no default controller) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view" />

    <!-- Custom Controls Overlay -->
    <FrameLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Gradient scrim top -->
        <View
            android:id="@+id/scrim_top"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="top"
            android:background="@android:color/transparent" />

        <!-- Top Bar: Back + Title -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@drawable/btn_focus_ring"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:focusable="true"
                android:contentDescription="Back"
                android:nextFocusDown="@+id/btn_play_pause" />

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/omnius_text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingStart="16dp" />
        </LinearLayout>

        <!-- Center Play/Pause Button -->
        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_media_pause"
            android:background="@drawable/btn_circle_focus"
            android:scaleType="centerInside"
            android:padding="16dp"
            android:focusable="true"
            android:contentDescription="Play/Pause"
            android:nextFocusUp="@id/btn_back"
            android:nextFocusDown="@+id/seek_bar"
            android:nextFocusLeft="@+id/btn_rewind"
            android:nextFocusRight="@+id/btn_forward" />

        <!-- Rewind Button (left of center) -->
        <ImageButton
            android:id="@+id/btn_rewind"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_marginEnd="160dp"
            android:src="@android:drawable/ic_media_rew"
            android:background="@drawable/btn_circle_focus"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:focusable="true"
            android:contentDescription="Rewind 10s"
            android:nextFocusRight="@id/btn_play_pause" />

        <!-- Forward Button (right of center) -->
        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_marginStart="160dp"
            android:src="@android:drawable/ic_media_ff"
            android:background="@drawable/btn_circle_focus"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:focusable="true"
            android:contentDescription="Forward 10s"
            android:nextFocusLeft="@id/btn_play_pause" />

        <!-- Bottom Controls -->
        <LinearLayout
            android:id="@+id/bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Seek Bar -->
            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb"
                android:focusable="true"
                android:nextFocusUp="@id/btn_play_pause"
                android:nextFocusDown="@+id/btn_subtitle" />

            <!-- Time + Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- Current time -->
                <TextView
                    android:id="@+id/txt_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/omnius_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:textColor="@color/omnius_text_secondary"
                    android:textSize="14sp" />

                <!-- Duration -->
                <TextView
                    android:id="@+id/txt_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/omnius_text_secondary"
                    android:textSize="14sp" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Speed Button -->
                <Button
                    android:id="@+id/btn_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="56dp"
                    android:text="1x"
                    android:textColor="@color/omnius_text_primary"
                    android:textSize="14sp"
                    android:background="@drawable/btn_focus_ring"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:nextFocusRight="@+id/btn_subtitle"
                    android:nextFocusUp="@id/seek_bar" />

                <!-- Subtitle Button -->
                <Button
                    android:id="@+id/btn_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="56dp"
                    android:text="CC"
                    android:textColor="@color/omnius_text_primary"
                    android:textSize="14sp"
                    android:background="@drawable/btn_focus_ring"
                    android:focusable="true"
                    android:layout_marginStart="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:nextFocusLeft="@id/btn_speed"
                    android:nextFocusUp="@id/seek_bar" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Subtitle Picker Panel (hidden, slides from right) -->
    <LinearLayout
        android:id="@+id/subtitle_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/panel_background"
        android:padding="16dp"
        android:visibility="gone"
        android:translationX="320dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subtitles"
            android:textColor="@color/omnius_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <!-- "Off" option -->
        <Button
            android:id="@+id/btn_subtitle_off"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Off"
            android:textColor="@color/omnius_text_primary"
            android:textSize="16sp"
            android:background="@drawable/panel_item_focus"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:id="@+id/subtitle_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Speed Picker Panel (hidden, anchored bottom-right near speed button) -->
    <LinearLayout
        android:id="@+id/speed_panel"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="80dp"
        android:orientation="vertical"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speed"
            android:textColor="@color/omnius_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_gravity="start" />

        <LinearLayout
            android:id="@+id/speed_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Buffering spinner -->
    <ProgressBar
        android:id="@+id/buffering_spinner"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

</FrameLayout>
